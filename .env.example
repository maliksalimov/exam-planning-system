# Copy this file to src/main/resources/application-local.properties and fill in real values.
# Never commit application-local.properties — it is in .gitignore.

DB_URL=jdbc:postgresql://<host>:5432/<dbname>
DB_USERNAME=<your-db-username>
DB_PASSWORD=<your-db-password>

# Generate a strong random secret (min 32 chars) for production:
#   openssl rand -base64 48
JWT_SECRET=<your-jwt-secret-min-32-chars>

# Optional: override the active Spring profile (default: local)
# SPRING_PROFILES_ACTIVE=prod
